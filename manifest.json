{
  "manifest_version": 3,
  "name": "Show Password on Hover",
  "version": "1.0.0",
  "description": "パスワード欄にマウスオーバーすると中身を表示します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
